# ============================================================
#  Intellekt Innovatsion Maktabi — muhit o'zgaruvchilari
#  Nusxalash:  cp .env.example .env   (keyin qiymatlarni to'ldiring)
#  Diqqat: .env fayli git'ga tushmaydi (.gitignore)
# ============================================================

# Port (Render/Railway buni o'zi beradi)
PORT=4000

# Ma'lumotlar papkasi. Standart: server/data
# Doimiy saqlash kerak bo'lsa: DATA_DIR=/var/lib/im-maktab
# DATA_DIR=./server/data

# Ishlab chiqarish rejimi (xatolarni yashirish, demo ogohlantirishlar)
NODE_ENV=production

# --- Hisoblar va parollar -----------------------------------
# Ustoz hisobini ro'yxatdan o'tkazish uchun taklif kodi.
# BO'SH BO'LSA ustoz hisobi ilova orqali umuman ochilmaydi (xavfsizroq).
# Harf-raqamli uzun kod ishlating (kamida 12 belgi).
STAFF_INVITE_CODE=

# Yangi parol uchun minimal uzunlik (kamida 6, tavsiya: 10+)
PASSWORD_MIN_LENGTH=8

# Namuna (demo) ma'lumotlarni yaratmaslik:
# ishlab chiqarishda SEED_DEMO=0 qo'ying (faqat ro'yxatdan o'tish orqali hisob ochiladi).
SEED_DEMO=1

# SEED_DEMO=0 bo'lganda birinchi ishga tushishda direktor hisobini yaratish.
# Parol kamida PASSWORD_MIN_LENGTH belgidan bo'lishi shart. Kod git'ga tushmasin!
# ADMIN_LOGIN=rektor
# ADMIN_PASSWORD=
# ADMIN_NAME=Bosh Direktor

# --- Sessiyalar ---------------------------------------------
# Sessiya umri (daqiqa). Standart: 480 (8 soat)
SESSION_TTL_MINUTES=480
# Bir vaqtda saqlanadigan sessiyalar soni
MAX_SESSIONS=5000

# --- Tarmoq / proxy -----------------------------------------
# Orqaga proxy (nginx, Render, Railway) ortida haqiqiy IP uchun: 1
# To'g'ridan-to'g'ri internetga ochiq bo'lsa: 0
TRUST_PROXY=1

# CORS faqat bir xil origin uchun ochiq. Alohida domendagi frontend bo'lsa:
# CORS_ORIGINS=https://maktab.uz,https://www.maktab.uz
CORS_ORIGINS=

# iframe/clickjacking siyosati. Standart (*) — preview uchun ochiq.
# Ishlab chiqarishda cheklang: FRAME_ANCESTORS='self' https://maktab.uz
FRAME_ANCESTORS=*
