# ============================================================
#  Intellekt Innovatsion Maktabi — .gitignore
# ============================================================

# --- Kutubxonalar (npm install bilan qayta o'rnatiladi) ---
node_modules/
client/node_modules/
server/node_modules/

# --- Build / cache ---
client/.smoke/
client/dist/
client/.vite/
*.tsbuildinfo
.esbuildcache

# --- Loglar ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Server ma'lumotlari (dastur o'zi yaratadi: seed qilinadi) ---
server/data/

# --- Muhit o'zgaruvchilari / maxfiy kalitlar ---
.env
.env.*
!.env.example
*.pem
*.key
.credentials

# --- Tahrirlovchilar / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Vaqtinchalik fayllar ---
tmp/
temp/
*.tmp
*.bak
